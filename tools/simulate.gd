extends SceneTree
## Runs the balance bot and writes a Markdown report. Use tools/simulate.sh:
##   bash tools/simulate.sh                        # 3 taps/s and 0 taps/s, 120 min -> docs/BALANCE.md
##   bash tools/simulate.sh --taps 5 --minutes 60 --out /tmp/b.md
##   bash tools/simulate.sh --forbid small_cubes --out /tmp/b.md   # never buy these upgrades (try one choice's other side)
## --taps takes a comma list (one run per value), --forbid a comma list of upgrade ids.

const Simulator := preload("res://tools/simulator.gd")
const Pacing := preload("res://tools/pacing.gd")


func _initialize() -> void:
	var args := _parse_args(OS.get_cmdline_user_args())
	var taps_list: PackedStringArray = String(args.get("taps", "3,0")).split(",", false)
	var minutes := float(args.get("minutes", "120"))
	var out: String = args.get("out", "res://docs/BALANCE.md")
	var forbid: Array = Array(String(args.get("forbid", "")).split(",", false))

	var sim: RefCounted = Simulator.new()
	var sections: PackedStringArray = []
	var by_profile := {}  ## "tapping"/"idle" -> result, for the pacing check
	for taps_text in taps_list:
		var taps := float(taps_text)
		var started := Time.get_ticks_msec()
		var result: Dictionary = sim.run(taps, minutes, {}, forbid)
		print("Simulated %s taps/s for %s min in %.1f s: %d items, all owned at %s" % [
			taps_text, minutes, (Time.get_ticks_msec() - started) / 1000.0, result["purchases"],
			"never" if float(result["all_bought_at"]) < 0.0 else Simulator._clock(result["all_bought_at"]),
		])
		sections.append(Simulator.to_markdown(result))
		if is_zero_approx(taps):
			by_profile["idle"] = result
		elif is_equal_approx(taps, Pacing.TAPS_PER_SEC):
			by_profile["tapping"] = result

	# The active profile (S.3): tapping plus Gold-pace hand solves, compared with plain tapping at 30 min.
	var active_started := Time.get_ticks_msec()
	var active: Dictionary = sim.run(Pacing.TAPS_PER_SEC, minf(minutes, Pacing.ACTIVE_MINUTES), Pacing.ACTIVE_HAND, forbid)
	print("Simulated the active profile for %s min in %.1f s: %d hand solves" % [
		minf(minutes, Pacing.ACTIVE_MINUTES), (Time.get_ticks_msec() - active_started) / 1000.0, active["hand_solves"]])
	sections.append(Simulator.to_markdown(active))
	by_profile["active"] = active

	# The other side of each choice pair (5.8): the tapping bot again for the first hour, once per pair, never buying the
	# side it picked (the greedy bot would never pick the other side by itself).
	if by_profile.has("tapping") and forbid.is_empty():
		var others: Array = []
		for picked: String in Simulator.chosen_sides(by_profile["tapping"]):
			var other_started := Time.get_ticks_msec()
			var other: Dictionary = sim.run(Pacing.TAPS_PER_SEC, minf(minutes, 60.0), {}, [picked])
			var label := "Not %s" % Content.get_upgrade(picked)["name"]
			print("Simulated the other side of %s for %s min in %.1f s" % [picked, minf(minutes, 60.0),
					(Time.get_ticks_msec() - other_started) / 1000.0])
			others.append([label, other])
		sections.append(Simulator.compare_markdown(by_profile["tapping"], others, 3600.0))

	var rows := Pacing.evaluate(by_profile)
	for row: Dictionary in rows:
		print("  %-16s %-17s %s" % [row["id"], row["status"], row["actual"]])
	var text := _header(minutes) + Pacing.to_markdown(rows) + "\n" + "\n".join(sections)
	var file := FileAccess.open(out, FileAccess.WRITE)
	if file == null:
		printerr("Could not write %s: %s" % [out, error_string(FileAccess.get_open_error())])
		quit(1)
		return
	file.store_string(text)
	file.close()
	print("Wrote %s" % ProjectSettings.globalize_path(out))
	quit(0)


func _header(minutes: float) -> String:
	return "\n".join([
		"# Balance",
		"",
		"Generated by `bash tools/simulate.sh` (game version %s). Don't edit by hand; re-run it after every" \
				% ProjectSettings.get_setting("application/config/version"),
		"content or formula change and commit the result. Targets are in PLAN §2.",
		"",
		"The bot drives the real `GameState` in %s s steps for %s minutes. Every second (and after each purchase)" \
				% [Simulator.STEP, Simulator._num(minutes)],
		"it picks the visible item with the lowest *time to afford + cost ÷ Solves/s gained* and buys it as soon",
		"as it can. Income counts helpers and taps. Times are m:ss from a fresh save.",
		"",
		"",
	])


func _parse_args(user_args: PackedStringArray) -> Dictionary:
	var result := {}
	var i := 0
	while i < user_args.size():
		var arg := user_args[i]
		if arg.begins_with("--") and i + 1 < user_args.size():
			result[arg.trim_prefix("--")] = user_args[i + 1]
			i += 2
		else:
			i += 1
	return result
