[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/stat_chip.gd" id="1_chip"]

[node name="StatChip" type="PanelContainer"]
theme_type_variation = &"StatChip"
script = ExtResource("1_chip")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"StatRow"

[node name="Icon" type="TextureRect" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(20, 20)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Value" type="Label" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_type_variation = &"StatValue"
text = "0"

[node name="Unit" type="Label" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_type_variation = &"StatUnit"
text = "/s"
