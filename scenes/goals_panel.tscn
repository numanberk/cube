[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/goals_panel.gd" id="1_goals"]
[ext_resource type="PackedScene" path="res://scenes/icon_sticker.tscn" id="2_sticker"]
[ext_resource type="Texture2D" path="res://assets/icons/federation_rankings.svg" id="3_icon"]
[ext_resource type="Texture2D" path="res://assets/icons/ui_close.svg" id="4_close"]
[ext_resource type="PackedScene" path="res://scenes/stat_chip.tscn" id="5_chip"]
[ext_resource type="Texture2D" path="res://assets/icons/stat_trophy.svg" id="6_trophy"]
[ext_resource type="Texture2D" path="res://assets/icons/small_cubes.svg" id="7_cubes"]
[ext_resource type="Script" path="res://scripts/ui/competition_view.gd" id="8_comps"]

[node name="GoalsPanel" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_goals")

[node name="Dim" type="ColorRect" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.55)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
unique_name_in_owner = true
layout_mode = 2

[node name="Box" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_type_variation = &"StackBox"

[node name="Header" type="HBoxContainer" parent="Center/Panel/Box"]
layout_mode = 2

[node name="TitleIcon" parent="Center/Panel/Box/Header" instance=ExtResource("2_sticker")]
custom_minimum_size = Vector2(44, 44)
layout_mode = 2
size_flags_vertical = 4
texture = ExtResource("3_icon")
category = &"trophies"

[node name="Title" type="Label" parent="Center/Panel/Box/Header"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Goals"

[node name="HeaderStats" type="HBoxContainer" parent="Center/Panel/Box/Header"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_type_variation = &"ColumnsBox"
alignment = 1

[node name="AchievementChip" parent="Center/Panel/Box/Header/HeaderStats" instance=ExtResource("5_chip")]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Achievements earned"
icon = ExtResource("6_trophy")
tone = "gold"

[node name="CollectionChip" parent="Center/Panel/Box/Header/HeaderStats" instance=ExtResource("5_chip")]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Cube Collection: items found"
icon = ExtResource("7_cubes")

[node name="CloseButton" type="Button" parent="Center/Panel/Box/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
tooltip_text = "Close (Esc)"
theme_type_variation = &"IconButton"
icon = ExtResource("4_close")

[node name="TitleRule" type="HSeparator" parent="Center/Panel/Box"]
layout_mode = 2
theme_type_variation = &"TitleRule"

[node name="Pages" type="TabContainer" parent="Center/Panel/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(1120, 520)
layout_mode = 2
current_tab = 0

[node name="Achievements" type="VBoxContainer" parent="Center/Panel/Box/Pages"]
unique_name_in_owner = true
layout_mode = 2
metadata/_tab_index = 0

[node name="Collection" type="HBoxContainer" parent="Center/Panel/Box/Pages"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"ColumnsBox"
metadata/_tab_index = 1

[node name="Stats" type="ScrollContainer" parent="Center/Panel/Box/Pages"]
unique_name_in_owner = true
visible = false
layout_mode = 2
horizontal_scroll_mode = 0
metadata/_tab_index = 2

[node name="Competitions" type="VBoxContainer" parent="Center/Panel/Box/Pages"]
unique_name_in_owner = true
visible = false
layout_mode = 2
script = ExtResource("8_comps")
metadata/_tab_index = 3
