static var _all_upgrades: Array[Dictionary] = []
static var _upgrade_index: Dictionary = {}


## Every upgrade: the hand-written UPGRADES, then each helper's milestones (HELPER_MILESTONES), built once.
static func get_upgrades() -> Array[Dictionary]:
	if _all_upgrades.is_empty():
		for def: Dictionary in UPGRADES:
			_all_upgrades.append(def)
		for helper: Dictionary in BUILDINGS:
			_all_upgrades.append_array(milestones_for(helper))
		for def in _all_upgrades:
			_upgrade_index[def["id"]] = def
	return _all_upgrades


## One helper's milestone upgrades, one per HELPER_MILESTONES row.
static func milestones_for(helper: Dictionary) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for row: Dictionary in HELPER_MILESTONES:
		out.append({
			"id": "ms_%s_%d" % [helper["id"], row["owned"]],
			"icon": helper["icon"],
			"name": "%s %s" % [helper.get("milestone_name", helper["name"]), row["tier"]],
			"description": "%ss work ×%s as fast. Needs %d %s." % [helper["name"], Num.format(float(row["mult"])),
					row["owned"], helper["name"] if int(row["owned"]) == 1 else helper["name"] + "s"],
			"cost": ceilf(float(helper["base_cost"]) * float(row["cost_mult"])),
			"effect": {"type": "building_mult", "target": helper["id"], "value": float(row["mult"])},
			"requires": {helper["id"]: int(row["owned"])},
			"milestone": true,
		})
	return out


static func get_upgrade(id: String) -> Dictionary:
	get_upgrades()
	return _upgrade_index.get(id, {})
